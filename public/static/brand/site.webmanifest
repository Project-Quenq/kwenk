{
  "name": "Kwenk",
  "short_name": "Kwenk",
  "description": "Kwenk is a creative, nostalgic social network built for real human connection. Customize your profile, write blog posts, join groups, and connect with friends online.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
